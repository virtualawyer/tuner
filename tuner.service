[Unit]
Description=Tuner (YouTube subscription recorder for Jellyfin)
After=network-online.target
Wants=network-online.target
# The library lives on the exFAT media drive. Never start before it mounts,
# or Tuner would create an empty library tree on the mount point itself.
RequiresMountsFor=/srv/media

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tuner
ExecStart=/usr/bin/python3 -m tuner
Restart=always
RestartSec=5
# yt-dlp writes into the library on the media drive; nothing needs $HOME.
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
